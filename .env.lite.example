# PersonMap Lite uses the same PostgreSQL server and schema as PersonMap.
# Set a local role/password that has CREATEDB permission; never commit secrets.
PERSONMAP_ENV=lite
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/personmap_lite

# Lease de ejecución Exposure Lens (30–900 segundos). IA desactivada por defecto.
EXPOSURE_RUN_LEASE_SECONDS=120

# Reconstrucción determinística / Graph V2. Sin IA ni nuevas consultas OSINT.
RECONSTRUCTION_MAX_TIMELINE_ITEMS=50
GRAPH_MAX_TOTAL_NODES=150
GRAPH_MAX_POST_NODES=30
GRAPH_MAX_DOCUMENT_NODES=30
GRAPH_MAX_EXPOSURE_NODES=30

# Fair automático: 225 s globales (incluye cierre), hasta tres rondas.
FAIR_TOTAL_DEADLINE_SECONDS=225
FAIR_MAX_WAVES=3
FAIR_USERNAME_SITES=100
# Web conserva su presupuesto nativo; Fair continúa lotes sin necesitar pivots.
SEARCH_MAX_QUERIES=60
SEARCH_MAX_QUERIES_PER_ROUND=10
SEARCH_TIMEOUT_SECONDS=120
SEARCH_READ_PAGES=true
SEARCH_MAX_PAGES=4
EXPOSURE_BATCH_SIZE=6
# IA opcional de presentación: selecciona solo hechos revisados existentes.
RECONSTRUCTION_AI_ENABLED=false
APIFY_INSTAGRAM_POSTS_ENABLED=true
# Permite aliases descubiertos además de las semillas habituales.
USERNAME_SCAN_MAX_ALIASES=6
# Cuatro adaptadores de contenido público; las demás redes usan fuentes nativas.
APIFY_ENABLED=true
APIFY_PLATFORMS=["instagram","tiktok","threads","youtube"]
FAIR_APIFY_PLATFORMS=["instagram","tiktok","threads","youtube"]
APIFY_PARALLELISM=2
APIFY_MAX_ACTORS=4
APIFY_MAX_RUNS=4
APIFY_MAX_CHARGE_PER_RUN_USD=0.025
APIFY_MAX_CHARGE_PER_INVESTIGATION_USD=0.10
# APIFY_TOKEN=<token del operador>
