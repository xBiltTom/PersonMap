# Output de Next.js — se regenera en el builder
.next/

# Archivos de entorno — se pasan en runtime
.env
.env.*
!.env.example

# Cache de TypeScript y ESLint
*.tsbuildinfo
.eslintcache

# Logs locales
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Herramientas de IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
