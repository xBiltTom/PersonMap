# =====================================================================
# PERSON-MAP // Environment Configuration
# =====================================================================

# Database (PostgreSQL local)
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/person_map

# LLM Configuration (OPCIONAL: LiteLLM model-agnostic layer)
# Deja estos campos vacíos para operar al 100% con el motor de reglas heurístico.
# Para activar IA, especifica el modelo y tu clave:
#
# Ejemplos:
# LLM_MODEL=gemini/gemini-2.0-flash
# LLM_API_KEY=AIzaSy...
#
# LLM_MODEL=groq/llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
#
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=sk-...
#
# LLM_MODEL=ollama/llama3
# LLM_API_KEY=ollama
LLM_MODEL=
LLM_API_KEY=

# =====================================================================
# Motor de busqueda para dorking (OPCIONAL)
# =====================================================================
# Tavily (https://tavily.com) es un buscador pensado para agentes: devuelve
# JSON estructurado con puntuacion de relevancia, en vez del HTML fragil que
# hay que raspar de DuckDuckGo. Nivel gratuito: 1.000 creditos/mes; una
# busqueda "basic" cuesta 1 credito y una "advanced", 2.
#
# Sin clave, search_dorker cae automaticamente a DuckDuckGo y el sistema
# mantiene el respaldo de DuckDuckGo (su disponibilidad depende de la red).
#
# Obten la clave en https://app.tavily.com (empieza por "tvly-").
#
# Límite global compartido entre rondas, con independencia del proveedor.
# Cada proveedor tiene además ese mismo tope de intentos; las consultas pueden
# usar respaldos y consumir créditos en más de una API. No hay reintentos pagos.
SEARCH_MAX_QUERIES=20
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
# Alias heredado; se usa solo si SEARCH_MAX_QUERIES no está definido.
TAVILY_MAX_QUERIES=5
TAVILY_MAX_RESULTS=8
# Sesga los resultados hacia el pais del publico objetivo (nombre ISO en ingles).
TAVILY_COUNTRY=peru
# Descarta los resultados que no contienen literalmente los terminos
# entrecomillados del dork. Tavily busca por relevancia semantica: sin esto, un
# dork de un correo inexistente devuelve la portada de su dominio. Ver
# docs/OSINT_SOURCES.md, "Trampas verificadas en produccion".
TAVILY_REQUIRE_LITERAL_MATCH=true

TAVILY_EXACT_MATCH=true
SEARCH_MAX_QUERIES_PER_ROUND=5
SEARCH_QUERY_CONCURRENCY=3
SEARCH_TIMEOUT_SECONDS=90
# Lectura pública adicional de HTML, texto y PDF con capa de texto.
# Límite compartido por expediente, también al continuar tras reiniciar.
SEARCH_READ_PAGES=true
SEARCH_MAX_PAGES=3
# Opcional: Tavily -> TinyFish Search -> Brave -> DuckDuckGo.
TINYFISH_API_KEY=
TINYFISH_LOCATION=PE
TINYFISH_LANGUAGE=es
# TinyFetch solo se usa como respaldo de lectura, con ambos flags y una key.
TINYFISH_FETCH_ENABLED=false
# Índice independiente opcional; requiere cuenta/clave y el plan del proveedor.
BRAVE_API_KEY=
BRAVE_COUNTRY=PE
BRAVE_SEARCH_LANGUAGE=es
# OpenAlex permite uso público sin clave; la clave opcional amplía su presupuesto.
OPENALEX_API_KEY=
# Crossref: API pública; el contacto opcional debe ser del operador, no del objetivo.
CROSSREF_ENABLED=true
CROSSREF_MAILTO=
# Límites acumulados por investigación; los bloqueos quedan como huecos de cobertura.
ACADEMIC_MAX_NAMES=3
ACADEMIC_MAX_ORCIDS=3
ACADEMIC_MAX_DOIS=3
ACADEMIC_MAX_REQUESTS=24
ACADEMIC_RESULTS_PER_QUERY=10
ACADEMIC_REQUEST_TIMEOUT=8
ACADEMIC_BATCH_TIMEOUT=60
# Token opcional de GitHub para endpoints públicos; nunca se persiste en resultados.
GITHUB_API_TOKEN=

# Optional Apify social enrichment: disabled unless operator explicitly opts in.
# Requires subject_consent recorded in the investigation (not infostealer consent).
# No cookies, subjects' credentials or arbitrary Actor inputs are accepted.
APIFY_ENABLED=false
APIFY_TOKEN=
APIFY_PLATFORMS=["instagram","tiktok"]
# Supported adapters: instagram, tiktok, threads, youtube. Pin builds after validation.
APIFY_ACTOR_BUILDS={"instagram":"0.0.643","tiktok":"0.0.489","youtube":"0.0.248"}
APIFY_MAX_ACTORS=2
APIFY_MAX_RUNS=2
APIFY_MAX_PROFILES_PER_ACTOR=3
APIFY_MAX_CONTENT_ITEMS_PER_PROFILE=10
# Legacy setting retained for configuration compatibility; superseded by the two limits above.
APIFY_MAX_ITEMS_PER_ACTOR=5
APIFY_DATASET_PAGE_SIZE=5
APIFY_RUN_TIMEOUT=60
APIFY_BATCH_TIMEOUT=150
APIFY_REQUEST_TIMEOUT=15
APIFY_MAX_RETRIES=1
APIFY_PARALLELISM=1
APIFY_MAX_CHARGE_PER_RUN_USD=0.05
APIFY_MAX_CHARGE_PER_INVESTIGATION_USD=0.10
APIFY_MAX_RESPONSE_BYTES=2000000

# =====================================================================
# Capa HTTP compartida y enumeracion de usernames
# =====================================================================
# Frontier: presupuestos de admisión, independientes de límites HTTP por tool.
PIVOT_FRONTIER_ENABLED=true
PIVOT_MAX_PER_ROUND=12
PIVOT_MAX_TOTAL=128
PIVOT_MAX_WEAK_PER_ROUND=2
PIVOT_MIN_PRIORITY=0
PIVOT_ROUND_COST_BUDGET=100
PIVOT_DEEP_MAX_ROUNDS=8
PIVOT_CORROBORATION_BONUS=30
# Modo por investigación: pivot_mode=standard|deep en POST /investigations.
# Tope global de peticiones salientes concurrentes de todo el proceso.
HTTP_MAX_CONCURRENCY=120
HTTP_MAX_PER_HOST=4
# Cuantas entradas del catalogo unificado se comprueban por alias.
# Se priorizan las plataformas curadas y todas las recetas de WhatsMyName;
# despues se agrega la cola de Maigret. Fast usa un prefijo menor.
# 0 = todo el catálogo activo, incluidas variantes de recetas.
USERNAME_SCAN_MAX_SITES=3400
USERNAME_SCAN_MAX_ALIASES=3
# Maigret 0.6.6: recetas completas y extracción, ejecutados en un proceso aislado.
MAIGRET_ENRICH=true
MAIGRET_PARSE=true
MAIGRET_RETRIES=1
MAIGRET_REQUEST_TIMEOUT=10
MAIGRET_WORKER_TIMEOUT=900
MAIGRET_TOOL_TIMEOUT=1800
MAIGRET_QUEUE_GRACE=30
MAIGRET_MAX_IDENTIFIERS=10
MAIGRET_MAX_PARSE_URLS=10
MAIGRET_MAX_PERMUTATIONS=10
# Opcionales, administrados en el servidor; no se aceptan desde una llamada.
MAIGRET_COOKIE_FILE=
MAIGRET_PROXY=
MAIGRET_TOR_PROXY=
MAIGRET_I2P_PROXY=
MAIGRET_SOLVER_URL=
MAIGRET_SOLVER_TIMEOUT=65
MAIGRET_SOLVER_CONCURRENCY=4
MAIGRET_CHECK_DOMAINS=false
# Snapshot propio descargado con ref explícita; reiniciar tras cambiarlo.
MAIGRET_DATABASE_FILE=
# Listas JSON opcionales; vacías conservan todo el catálogo.
MAIGRET_TAGS=[]
MAIGRET_SITE_NAMES=[]
MAIGRET_EXCLUDED_TAGS=[]
MAIGRET_KEYWORDS=[]
SOCIAL_VERIFY_CONCURRENCY=8
SOCIAL_VERIFY_MAX_URLS=300
SOCIAL_VERIFY_URL_TIMEOUT=20

# =====================================================================
# Busqueda inversa de imagen (OPCIONAL, de pago)
# =====================================================================
# El proveedor está desactivado si no hay clave. La cosecha activa de
# avatares los sustituye sin coste (ver docs/OSINT_SOURCES.md).
SERPAPI_KEY=
# Bing Search APIs se retiraron el 11-08-2025; BING_VISUAL_SEARCH_KEY ya no activa llamadas.

# =====================================================================
# DNI en documentos publicados de forma abierta (OPCIONAL)
# =====================================================================
# URLs de publicaciones, sin espejos privados de consulta de identidad.
DNI_PUBLIC_SOURCE_URLS=[]
DNI_MAX_PUBLIC_SOURCES=4

# Server Ports & CORS
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# MCP local: genera una credencial con backend/scripts/personmap_mcp.py setup.
MCP_ENABLED=true
MCP_API_KEY=
MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","[::1]:*"]
# Herramientas independientes por expediente; una ejecución de cada herramienta a la vez.
MCP_MAX_PARALLEL_TOOLS=3
# Primer barrido MCP por alias; deep amplía hasta USERNAME_SCAN_MAX_SITES.
MCP_USERNAME_FAST_SITES=200
# Consultas adicionales al revisar un barrido tradicional terminado (0 desactiva búsquedas).
MCP_REVIEW_MAX_QUERIES=3
FRONTEND_URL=http://localhost:3000

# GHunt 2.3.4: runtime independiente (backend/integrations/ghunt).
# Instalar: cd backend && uv sync --project integrations/ghunt --python 3.12 --frozen
# Sesión del operador, nunca del investigado. No pegar tokens en la UI/MCP.
GHUNT_ENABLED=true
# Vacío usa backend/integrations/ghunt/.venv/bin/python
GHUNT_PYTHON=
# Ruta absoluta a creds.m de GHunt; vacío mantiene GHunt sin autenticar.
GHUNT_CREDENTIALS_FILE=
GHUNT_SERVICES=["maps","calendar","play_games"]
GHUNT_MAX_QUERIES=3
GHUNT_MAX_DRIVE_FILES=3
GHUNT_WORKER_TIMEOUT=180
GHUNT_REQUEST_TIMEOUT=20
GHUNT_MAX_REQUESTS=80
GHUNT_MAX_EVENTS=20

# Enumeración de correo: consultas revisadas de Holehe + sondas propias.
# [] usa el catálogo; ejemplo de selección: ["spotify","wordpress","lastfm"]
EMAIL_ENUM_SITES=[]
EMAIL_ENUM_MAX_EMAILS=3
EMAIL_ENUM_CONCURRENCY=6
EMAIL_ENUM_REQUEST_TIMEOUT=7
EMAIL_ENUM_PROBE_TIMEOUT=20
EMAIL_ENUM_BATCH_TIMEOUT=90
