# =====================================================================
# PERSON-MAP // Environment Configuration
# =====================================================================

# Database (PostgreSQL local)
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/person_map

# LLM Configuration (OPCIONAL: LiteLLM model-agnostic layer)
# Deja estos campos vacíos para operar al 100% con el motor de reglas heurístico.
# Para activar IA, especifica el modelo y tu clave:
#
# Ejemplos:
# LLM_MODEL=gemini/gemini-2.0-flash
# LLM_API_KEY=AIzaSy...
#
# LLM_MODEL=groq/llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
#
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=sk-...
#
# LLM_MODEL=ollama/llama3
# LLM_API_KEY=ollama
LLM_MODEL=
LLM_API_KEY=

# Server Ports & CORS
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
