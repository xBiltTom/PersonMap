# =====================================================================
# PERSON-MAP // Environment Configuration
# =====================================================================

# Database (PostgreSQL local)
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/person_map

# LLM Configuration (OPCIONAL: LiteLLM model-agnostic layer)
# Deja estos campos vacíos para operar al 100% con el motor de reglas heurístico.
# Para activar IA, especifica el modelo y tu clave:
#
# Ejemplos:
# LLM_MODEL=gemini/gemini-2.0-flash
# LLM_API_KEY=AIzaSy...
#
# LLM_MODEL=groq/llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
#
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=sk-...
#
# LLM_MODEL=ollama/llama3
# LLM_API_KEY=ollama
LLM_MODEL=
LLM_API_KEY=

# =====================================================================
# Motor de busqueda para dorking (OPCIONAL)
# =====================================================================
# Tavily (https://tavily.com) es un buscador pensado para agentes: devuelve
# JSON estructurado con puntuacion de relevancia, en vez del HTML fragil que
# hay que raspar de DuckDuckGo. Nivel gratuito: 1.000 creditos/mes; una
# busqueda "basic" cuesta 1 credito y una "advanced", 2.
#
# Sin clave, search_dorker cae automaticamente a DuckDuckGo y el sistema
# sigue funcionando al 100%.
#
# Obten la clave en https://app.tavily.com (empieza por "tvly-").
#
# Coste real medido: el motor puede re-ejecutar el dorker en varias rondas tras
# pivotar, asi que una investigacion consume TAVILY_MAX_QUERIES creditos por
# ronda en que se ejecute (~10 creditos con los valores por defecto). Con el
# nivel gratuito eso da alrededor de 100 investigaciones al mes.
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_QUERIES=5
TAVILY_MAX_RESULTS=8
# Sesga los resultados hacia el pais del publico objetivo (nombre ISO en ingles).
TAVILY_COUNTRY=peru
# Descarta los resultados que no contienen literalmente los terminos
# entrecomillados del dork. Tavily busca por relevancia semantica: sin esto, un
# dork de un correo inexistente devuelve la portada de su dominio. Ver
# docs/OSINT_SOURCES.md, "Trampas verificadas en produccion".
TAVILY_REQUIRE_LITERAL_MATCH=true

# =====================================================================
# Capa HTTP compartida y enumeracion de usernames
# =====================================================================
# Tope global de peticiones salientes concurrentes de todo el proceso.
HTTP_MAX_CONCURRENCY=40
# Cuantas entradas del catalogo unificado se comprueban por alias.
# Las redes principales se priorizan; ampliar agrega la cola de Maigret.
USERNAME_SCAN_MAX_SITES=500
SOCIAL_VERIFY_CONCURRENCY=8
SOCIAL_VERIFY_MAX_URLS=300
SOCIAL_VERIFY_URL_TIMEOUT=20

# =====================================================================
# Busqueda inversa de imagen (OPCIONAL, de pago)
# =====================================================================
# Ambos backends estan desactivados si no hay clave. La cosecha activa de
# avatares los sustituye sin coste (ver docs/OSINT_SOURCES.md).
SERPAPI_KEY=
BING_VISUAL_SEARCH_KEY=

# =====================================================================
# Consulta de DNI/RUC Peru - RENIEC (OPCIONAL)
# =====================================================================
# Token Bearer de apis.net.pe (registro gratuito: https://apis.net.pe).
# Sin token, dni_lookup intenta la v1 publica y luego apisperu.com como
# mirror de respaldo — el sistema sigue funcionando aunque con menor
# disponibilidad cuando los mirrors publicos estan bajo mantenimiento.
APIS_NET_PE_TOKEN=

# Server Ports & CORS
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
